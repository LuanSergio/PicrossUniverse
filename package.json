{
  "name": "picross-universe",
  "version": "1.0.0",
  "description": "A random Picross generate tool using Js",
  "repository": "https://github.com/luansergiomattos/PicrossJs.git",
  "author": "Luan Sergio Mattos",
  "license": "MIT",
  "private": true,
  "source": [
    "index.html",
    "offline.html"
  ],
  "scripts": {
    "start": "parcel --dist-dir dev --open",
    "build": "parcel build --public-url ./"
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "parcel": "^2.16.4",
    "posthtml-include": "^2.0.1",
    "sass": "^1.108.1"
  }
}
